+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+// 会话鉴权共享单例：JWT 校验 + artifactsPath 缓存 + XService 接口。
+// 供 RemoteAgentFileSystemProviderChannel（文件操作鉴权）与
+// ExtensionHostConnection（扩展宿主 env 注入）复用，保证同进程内缓存一致。
+
+import * as https from 'https';
+import { constants as cryptoConstants } from 'crypto';
+
+// TLS 请求选项：不校验证书（内网自签名），允许 legacy renegotiation
+const TLS_REQUEST_OPTIONS: https.RequestOptions = {
+	rejectUnauthorized: false,
+	secureOptions: cryptoConstants.SSL_OP_ALLOW_UNSAFE_LEGACY_RENEGOTIATION | cryptoConstants.SSL_OP_LEGACY_SERVER_CONNECT,
+};
+
+// ─── XService Environment URL Mapping ──────────
+export const ENV_SERVICE_URLS: Record<string, string> = {
+	dev: 'https://x-service.paas.cmbchina.cn',
+	st:  'https://x-service.paasst.cmbchina.cn',
+	oa:  'https://xservice.paasuat.cmbchina.cn',
+	prd: 'https://xservice-prd.paas.cmbchina.cn',
+};
+const AUTH_CACHE_TTL = 12 * 60 * 60 * 1000; // 12 hours
+
+// 进程级共享缓存：sessionID → { artifactsPath, expireAt }
+const authCache = new Map<string, { artifactsPath: string; expireAt: number }>();
+
+//#region Cache helpers
+
+function getCachedArtifactsPath(sessionID: string): string | null {
+	const entry = authCache.get(sessionID);
+	if (entry && entry.expireAt > Date.now()) {
+		return entry.artifactsPath;
+	}
+	authCache.delete(sessionID);
+	return null;
+}
+
+function setCachedArtifactsPath(sessionID: string, artifactsPath: string): void {
+	authCache.set(sessionID, { artifactsPath, expireAt: Date.now() + AUTH_CACHE_TTL });
+}
+
+//#endregion
+
+//#region JWT validation
+
+function isTokenExpired(idToken: string): boolean {
+	try {
+		const parts = idToken.split('.');
+		if (parts.length !== 3) {
+			return true;
+		}
+		const payload = JSON.parse(Buffer.from(parts[1], 'base64url').toString('utf-8'));
+		if (!payload.exp || typeof payload.exp !== 'number') {
+			return true;
+		}
+		return payload.exp * 1000 < Date.now();
+	} catch {
+		return true;
+	}
+}
+
+//#endregion
+
+//#region XService API
+
+function fetchArtifactsPath(runEnv: string, sessionID: string, idToken: string): Promise<string> {
+	return new Promise((resolve, reject) => {
+		const baseUrl = ENV_SERVICE_URLS[runEnv];
+		if (!baseUrl) {
+			return reject(new Error(`Unknown run_env: ${runEnv}`));
+		}
+
+		const url = `${baseUrl}/api/v1/sessions/${sessionID}/detail?healthCheck=false`;
+		const req = https.get(url, {
+			headers: { 'Id-Token': idToken },
+			timeout: 10000,
+			...TLS_REQUEST_OPTIONS,
+		}, (res) => {
+			let data = '';
+			res.on('data', (chunk: Buffer) => { data += chunk.toString(); });
+			res.on('end', () => {
+				try {
+					const json = JSON.parse(data);
+					if (json.returnCode === 'SUC0000' && json.data?.artifactsPath) {
+						resolve(json.data.artifactsPath);
+					} else {
+						reject(new Error(`XService returned: ${json.returnCode}`));
+					}
+				} catch (e) {
+					reject(new Error(`Failed to parse XService response: ${(e as Error).message}`));
+				}
+			});
+		});
+
+		req.on('error', (e: Error) => reject(new Error(`XService request failed: ${e.message}`)));
+		req.on('timeout', () => {
+			req.destroy();
+			reject(new Error('XService request timed out'));
+		});
+	});
+}
+
+//#endregion
+
+//#region Public API
+
+/**
+ * 获取会话允许访问的 artifactsPath（进程级共享单例）。
+ * 流程：JWT 过期校验 → 内存缓存 → 调用 XService 接口（接口返回值可信，直接缓存原始值）。
+ * 失败时抛出异常，由调用方决定 fail-close 策略。
+ */
+export async function getArtifactsPath(sessionID: string, idToken: string, runEnv: string): Promise<string> {
+	// 1. 认证：JWT 格式校验 + 过期检查
+	if (isTokenExpired(idToken)) {
+		throw new Error('ID-Token is invalid or expired');
+	}
+
+	// 2. 缓存：优先从缓存获取允许访问的路径
+	const cached = getCachedArtifactsPath(sessionID);
+	if (cached) {
+		return cached;
+	}
+
+	// 3. 鉴权：调用 XService 接口获取 artifactsPath
+	const artifactsPath = await fetchArtifactsPath(runEnv || 'dev', sessionID, idToken);
+	setCachedArtifactsPath(sessionID, artifactsPath);
+	return artifactsPath;
+}
